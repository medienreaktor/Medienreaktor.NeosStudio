# EditorConfig for Medienreaktor.NeosStudio
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PHP follows PSR-12 (4-space indentation)
[*.php]
indent_size = 4

# Trailing whitespace is significant in Markdown (hard line breaks)
[*.md]
trim_trailing_whitespace = false
