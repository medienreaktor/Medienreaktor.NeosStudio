# Development-only files stay out of the Composer package (git archive, and
# with it the Packagist dist, skips export-ignore paths).

# Design token export: the Figma dumps and the figma-tools configuration that
# generate src/styles/*.css - the generated CSS is what ships.
/figma-tools.json export-ignore
/figma-variables.json export-ignore
/figma-text-styles.json export-ignore

# Repository tooling.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
