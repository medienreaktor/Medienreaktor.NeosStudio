diff --git a/Classes/Service/LegacyRemovalAttachmentPoint.php b/Classes/Service/LegacyRemovalAttachmentPoint.php
new file mode 100644
index 0000000..2995003
--- /dev/null
+++ b/Classes/Service/LegacyRemovalAttachmentPoint.php
@@ -0,0 +1,31 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Medienreaktor\NeosApi\Service;
+
+use Neos\Neos\PendingChangesProjection\Change;
+
+/**
+ * Whether this Neos still knows the "removal attachment point" of a hard
+ * removal - the one thing that makes a RemoveNodeAggregate attributable to a
+ * document once the removed node is gone from the workspace graph.
+ *
+ * Neos 9.1 carries it from the command through the event into the
+ * pending-changes projection (Change::getLegacyRemovalAttachmentPoint()), and
+ * WorkspacePublishingService::isChangePublishableWithinAncestorScope() walks
+ * up from it when a publish or discard is scoped to a site or document.
+ * Neos 9.2 dropped it from command, event and projection (soft removals made
+ * it obsolete): a scoped publish there resolves every change from the changed
+ * node itself, so a hard removal in a workspace can only be published with the
+ * whole workspace. The API adapts on both ends of that - what a
+ * RemoveNodeAggregate dispatches (CommandsController) and which node a
+ * deletion is grouped by (WorkspaceReadContext) - so the gate lives here once.
+ */
+final class LegacyRemovalAttachmentPoint
+{
+    public static function isSupported(): bool
+    {
+        return method_exists(Change::class, 'getLegacyRemovalAttachmentPoint');
+    }
+}
diff --git a/Classes/Service/WorkspaceReadContext.php b/Classes/Service/WorkspaceReadContext.php
index cd6646b..0d27d1d 100644
