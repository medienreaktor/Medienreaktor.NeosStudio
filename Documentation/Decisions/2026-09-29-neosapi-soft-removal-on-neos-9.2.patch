+    /**
+     * The command a client's RemoveNodeAggregate actually dispatches.
+     *
+     * A HARD removal where Neos still records the removal attachment point
+     * (9.1 - filled in handleCommand(), it keeps the deletion publishable per
+     * site/document). Neos 9.2 dropped that record, and its publishing service
+     * scopes every change by walking up from the changed node itself - a
+     * hard-removed node is gone from the workspace graph, so the deletion
+     * matches no site and no document and can only ever be published or
+     * discarded with the whole workspace (see LegacyRemovalAttachmentPoint).
+     * Neos 9.2 itself never hard-removes inside a workspace for exactly that
+     * reason (the Neos UI tags the subtree "removed", see
+     * NeosSubtreeTag::removed()), so neither does the API: the removal becomes
+     * the soft removal this package documents as the deletion anyway -
+     * reviewable, scopable, restorable from the trash, and erased in live by
+     * the soft-removal garbage collector once published. Root workspaces keep
+     * the hard removal: nothing is published from them, and the garbage
+     * collector only sweeps live.
+     */
+    private function removalCommand(RemoveNodeAggregate $command): CommandInterface
+    {
+        if (LegacyRemovalAttachmentPoint::isSupported()) {
+            return $command;
+        }
+        $workspace = $this->getContentRepository()->findWorkspaceByName($command->workspaceName);
+        // An unknown workspace fails downstream with the core's own error, as before.
+        if ($workspace === null || $workspace->isRootWorkspace()) {
+            return $command;
+        }
+
+        return TagSubtree::create(
+            $command->workspaceName,
+            $command->nodeAggregateId,
+            $command->coveredDimensionSpacePoint,
+            $command->nodeVariantSelectionStrategy,
+            NeosSubtreeTag::removed()
+        );
+    }
